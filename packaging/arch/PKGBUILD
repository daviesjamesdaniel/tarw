# Maintainer: Dan Davies <davies.james.daniel@gmail.com>
pkgname=tarw
pkgver=0.1.0
pkgrel=1
pkgdesc="A FOSS, native Linux email client - Wayland-first, built on real IMAP/SMTP infrastructure"
arch=('x86_64')
url="https://github.com/daviesjamesdaniel/tarw"
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'librsvg')
makedepends=('rust' 'cargo')
options=('!lto')

# Local-only build for now: no source=() VCS fetch, builds directly from the
# checked-out repo this PKGBUILD lives in (packaging/arch/PKGBUILD, two
# directories below the repo root). Switch to a proper git source (or a
# release tarball) before submitting to the AUR.
_srcdir="$startdir/../.."

build() {
  cd "$_srcdir/src-tauri"
  cargo build --release --locked
}

package() {
  install -Dm755 "$_srcdir/src-tauri/target/release/tarw" "$pkgdir/usr/bin/tarw"
  install -Dm644 "$_srcdir/src-tauri/icons/128x128.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/dan.tarw.png"
  install -Dm644 "$_srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/dan.tarw.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Tarw
Comment=$pkgdesc
Exec=tarw
Icon=dan.tarw
Terminal=false
Categories=Network;Email;
EOF
}
