# Copy this file to .env and fill in real values yourself (never commit .env).
#
# App-password auth (used if GOOGLE_OAUTH_CLIENT_ID is left unset):
IMAP_USER=
IMAP_APP_PASSWORD=

# OAuth2 auth (preferred - set these to switch imap_client.rs onto the
# OAuth2 path instead of the app password above):
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
